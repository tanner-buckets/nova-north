.env
.env.local
node_modules/
.supabase/

# Supabase CLI local state: project ref, pooler URL, service versions.
supabase/.temp/

# Player data: deny by default.
#
# The spreadsheet exports carry full names, and most players are children.
# CLAUDE.md: last name is protected, and the only public player fields are
# Player ID, first name and last initial. This repository is public.
#
# Everything in data/source/ is excluded unless explicitly allowed below, so a
# new export dropped in here is ignored by default rather than by luck.
data/source/*
!data/source/earning-actions.csv
!data/source/prize-items.csv

# Database backups: deny by default.
#
# A dump holds every player's full name and birth year in plain text, and most
# players are children. Backups belong outside this repository entirely -- see
# "Backing up the database" in the README -- and this is the seatbelt for the
# day somebody runs pg_dump with the working directory set here. Migrations are
# .sql and tracked, so *.sql cannot be ignored wholesale; these are the names a
# dump actually takes.
*.dump
*.dump.gz
*backup*.sql
*.pgdump

# Local-only demo pages. Never committed.
_demo*.html
_demo*.js
_demo*.css
